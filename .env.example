# Zebra's Shop production secrets belong in Render > Environment, never in GitHub.
# This is only a placeholder template. NEVER put real credentials in this file.
NODE_ENV=production
PUBLIC_URL=https://zebra-bl-marketplace.onrender.com
DATABASE_URL=
DISABLE_CHECKOUT=1
ALLOW_LIVE_SALES=0
ENABLE_TEST_CHECKOUT=0
SCRIPT_STORAGE_DIR=./sealed-payloads
ZEBRA_PAYLOAD_KEY=
OTP_SECRET=
# Public customer sign-ins: use an activated Brevo transactional account with a VERIFIED sender.
# Brevo accepts a verified personal Gmail sender; it may rewrite the from-domain
# to its own transactional domain. Deliverability is not guaranteed; test it.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Zebra's Shop
# Resend optional fallback. onboarding@resend.dev only sends to Resend account owner.
RESEND_API_KEY=
MAIL_FROM=
# Stripe must be fully configured in test mode before changing DISABLE_CHECKOUT.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPPORT_EMAIL=
# Enable Stripe-issued receipts in the Stripe Dashboard Customer emails setting.

# Server-only 100% off code, capped at five verified Stripe redemptions
# and one free order per account. Does not unlock without completed Checkout.
ZEBRA_FREE_PROMO_CODE=

# Sandbox testing on a PUBLIC Render site: prevent strangers from buying with test cards.
# Comma-separated email addresses of testers you control, PRIVATE to Render.
STRIPE_TEST_ALLOWED_EMAILS=
# Must be 1 to let allowlisted testers open sandbox Checkout.
ENABLE_TEST_CHECKOUT=0
# Keep 0 for diagnostic-only testing. Set 1 only for a deliberate script-delivery test.
ENABLE_TEST_SOFTWARE_DELIVERY=0
# Never enable live charges without completing payment, webhook, license and refund tests.
ALLOW_LIVE_SALES=0
DISABLE_CHECKOUT=1
